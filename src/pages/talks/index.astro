---
import Base from "../../layouts/Base.astro";
---

<Base title="Talks">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-3xl font-bold mb-8 text-gray-900 dark:text-gray-100">Talks</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-8">
      I've given talks at various meetups and conferences. Here's a collection of the presentations.
    </p>
    <div class="grid gap-6">
      <div class="p-6 bg-gray-50 dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
        <h3 class="font-bold text-lg mb-1 text-gray-900 dark:text-gray-100">U2 should have used Elasticsearch</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">DUG</p>
        <a href="/talks/U2_should_have_used_Elasticsearch.pdf" class="text-primary-600 dark:text-primary-400 hover:underline">Download PDF &rarr;</a>
      </div>
      <div class="p-6 bg-gray-50 dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
        <h3 class="font-bold text-lg mb-1 text-gray-900 dark:text-gray-100">Moar logs! Logging on Linux using the ELK Stack</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">JLUG</p>
        <a href="/talks/Moar_Logs.pdf" class="text-primary-600 dark:text-primary-400 hover:underline">Download PDF &rarr;</a>
      </div>
      <div class="p-6 bg-gray-50 dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
        <h3 class="font-bold text-lg mb-1 text-gray-900 dark:text-gray-100">A gentle introduction into Elasticsearch</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">Elasticsearch SA Meetup</p>
        <a href="/talks/Gentle_intro_to_Elasticsearch.pdf" class="text-primary-600 dark:text-primary-400 hover:underline">Download PDF &rarr;</a>
      </div>
      <div class="p-6 bg-gray-50 dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
        <h3 class="font-bold text-lg mb-1 text-gray-900 dark:text-gray-100">Everything's Connected: Hacking the interwebs with Logstash</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">Jozi.rb Meetup</p>
        <a href="/talks/logstash-jozi-rb" class="text-primary-600 dark:text-primary-400 hover:underline">View Reveal.js deck &rarr;</a>
      </div>
      <div class="p-6 bg-gray-50 dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
        <h3 class="font-bold text-lg mb-1 text-gray-900 dark:text-gray-100">Leveraging the ELK stack to ensure API uptime</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">Elasticsearch SA Meetup</p>
        <a href="/talks/tutuka-elk" class="text-primary-600 dark:text-primary-400 hover:underline">View Reveal.js deck &rarr;</a>
      </div>
      <div class="p-6 bg-gray-50 dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
        <h3 class="font-bold text-lg mb-1 text-gray-900 dark:text-gray-100">Everything's Connected: Hacking the interwebs with Logstash</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">Rubyfuza 2015 (Lightening Talk)</p>
        <a href="/talks/logstash-hacking-the-interwebs" class="text-primary-600 dark:text-primary-400 hover:underline">View Reveal.js deck &rarr;</a>
      </div>
      <div class="p-6 bg-gray-50 dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
        <h3 class="font-bold text-lg mb-1 text-gray-900 dark:text-gray-100">How CoffeeScript Improved My JavaScript Skills</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">JSinSA 2014</p>
        <a href="/talks/learning-from-coffeescript" class="text-primary-600 dark:text-primary-400 hover:underline">View Reveal.js deck &rarr;</a>
      </div>
      <div class="p-6 bg-gray-50 dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
        <h3 class="font-bold text-lg mb-1 text-gray-900 dark:text-gray-100">PHP - The slums of the programming world?</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">Tech 4 Africa 2013</p>
        <a href="/talks/phpslums/" class="text-primary-600 dark:text-primary-400 hover:underline">View Reveal.js deck &rarr;</a>
      </div>
      <div class="p-6 bg-gray-50 dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
        <h3 class="font-bold text-lg mb-1 text-gray-900 dark:text-gray-100">Application Development with Elasticsearch</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">Elasticsearch SA Meetup</p>
        <a href="/talks/Application Development with Elasticsearch.pdf" class="text-primary-600 dark:text-primary-400 hover:underline">Download PDF &rarr;</a>
      </div>
      <div class="p-6 bg-gray-50 dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
        <h3 class="font-bold text-lg mb-1 text-gray-900 dark:text-gray-100">Elasticsearch Health Check</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">Elasticsearch SA Meetup</p>
        <a href="/talks/Elasticsearch_Health_Check.pdf" class="text-primary-600 dark:text-primary-400 hover:underline">Download PDF &rarr;</a>
      </div>
    </div>
  </div>
</Base>
