---
import Base from "../../layouts/Base.astro";

interface Talk {
  title: string;
  event: string;
  url: string;
}

const talks: Talk[] = [
  { title: "U2 should have used Elasticsearch", event: "DUG", url: "/talks/U2_should_have_used_Elasticsearch.pdf" },
  { title: "Moar logs! Logging on Linux using the ELK Stack", event: "JLUG", url: "/talks/Moar_Logs.pdf" },
  { title: "A gentle introduction into Elasticsearch", event: "Elasticsearch SA Meetup", url: "/talks/Gentle_intro_to_Elasticsearch.pdf" },
  { title: "Everything's Connected: Hacking the interwebs with Logstash", event: "Jozi.rb Meetup", url: "/talks/logstash-jozi-rb" },
  { title: "Leveraging the ELK stack to ensure API uptime", event: "Elasticsearch SA Meetup", url: "/talks/tutuka-elk" },
  { title: "Everything's Connected: Hacking the interwebs with Logstash", event: "Rubyfuza 2015 — Lightning Talk", url: "/talks/logstash-hacking-the-interwebs" },
  { title: "How CoffeeScript Improved My JavaScript Skills", event: "JSinSA 2014", url: "/talks/learning-from-coffeescript" },
  { title: "PHP — The slums of the programming world?", event: "Tech 4 Africa 2013", url: "/talks/phpslums/" },
  { title: "Application Development with Elasticsearch", event: "Elasticsearch SA Meetup", url: "/talks/Application Development with Elasticsearch.pdf" },
  { title: "Elasticsearch Health Check", event: "Elasticsearch SA Meetup", url: "/talks/Elasticsearch_Health_Check.pdf" },
];

const meta = (url: string) => {
  const isPdf = url.toLowerCase().endsWith(".pdf");
  return {
    kind: isPdf ? "PDF" : "DECK",
    cta: isPdf ? "Download PDF" : "Open deck",
  };
};
---

<Base title="Talks">
  <header class="mb-10 animate-rise-in">
    <p class="label label--accent">// from the stage</p>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink">
      Talks
    </h1>
    <p class="mt-3 max-w-xl text-ink-soft">
      Slides and decks from meetups and conferences — mostly Elasticsearch, the
      ELK stack, and the occasional spicy take on PHP.
    </p>
  </header>

  <div class="grid gap-5 sm:grid-cols-2">
    {
      talks.map((talk) => {
        const m = meta(talk.url);
        const external = talk.url.startsWith("http");
        return (
          <a
            href={talk.url}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener noreferrer" : undefined}
            class="note-card group flex flex-col rounded-xl p-5"
          >
            <div class="mb-3 flex items-center justify-between">
              <span class="rounded border border-line px-1.5 py-0.5 font-mono text-[0.6rem] font-semibold tracking-wider text-ink-faint transition-colors group-hover:border-accent group-hover:text-accent">
                {m.kind}
              </span>
              <span class="font-mono text-xs text-ink-faint">{talk.event}</span>
            </div>
            <h3 class="font-display text-lg font-semibold leading-snug text-ink">
              {talk.title}
            </h3>
            <span class="mt-4 inline-flex items-center gap-1.5 font-mono text-xs text-accent">
              {m.cta}
              <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
            </span>
          </a>
        );
      })
    }
  </div>
</Base>
