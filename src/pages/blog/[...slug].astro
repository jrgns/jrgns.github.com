---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import type { APIRoute } from "astro";

export const getStaticPaths: APIRoute = async () => {
  const posts = (await getCollection("blog")).filter(
    (p) => p.data.section === "blog"
  );
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
};

const { post } = Astro.props;
const { Content } = await post.render();
const date = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Base title={post.data.title} description={post.data.description}>
  <article class="animate-rise-in">
    <a
      href="/archive/"
      class="link-grow font-mono text-xs text-ink-soft"
    >
      &larr; all posts
    </a>

    <header class="mb-8 mt-4">
      <p class="label label--accent">{date}</p>
      <h1
        class="mt-3 font-display text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl"
      >
        {post.data.title}
      </h1>
      <p class="mt-3 font-mono text-xs text-ink-faint">
        by Jurgens du Toit
      </p>
      <div class="perforate mt-6"></div>
    </header>

    <div class="prose">
      <Content />
    </div>

    <div class="perforate mt-12"></div>
    <a
      href="/archive/"
      class="mt-6 inline-block link-grow font-mono text-sm text-ink-soft"
    >
      &larr; more posts
    </a>
  </article>
</Base>
