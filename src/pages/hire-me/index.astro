---
import Base from "../../layouts/Base.astro";

const skills = [
  "Systems Development",
  "Web Development",
  "PHP",
  "Ruby",
  "Elasticsearch / ELK",
  "Integrations",
];
---

<Base title="Hire Me">
  <header class="mb-8 animate-rise-in">
    <p class="label label--accent">// open for interesting problems</p>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink">
      Hire me
    </h1>
  </header>

  <div class="space-y-6">
    <p class="text-lg leading-relaxed text-ink-soft">
      Become more productive by delegating your problem solving to me. I consult
      for clients who need an expert developer, integrator, and
      <span class="font-semibold text-ink">problem solver</span> — someone who
      reads the logs <em>and</em> ships the fix.
    </p>

    <div class="note-card rounded-xl p-6">
      <p class="label mb-4">core skills</p>
      <ul class="flex flex-wrap gap-2">
        {
          skills.map((skill) => (
            <li class="rounded-full border border-line bg-paper px-3 py-1 font-mono text-xs text-ink-soft">
              {skill}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="rounded-xl border border-ink bg-ink p-6 text-paper">
      <p class="label mb-2" style="color: var(--paper);">get in touch</p>
      <p class="text-paper/80">
        Got a question or need a quote? Drop me a line:
      </p>
      <a
        href="mailto:jrgns@jrgns.net"
        class="mt-1 inline-block font-display text-2xl font-semibold text-paper underline decoration-accent decoration-2 underline-offset-4 hover:text-accent"
      >
        jrgns@jrgns.net
      </a>
      <div class="mt-6">
        <a
          href="/JJ%20du%20Toit.CV.pdf"
          class="group inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5"
        >
          Download CV (PDF)
          <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">&darr;</span>
        </a>
      </div>
    </div>
  </div>
</Base>
