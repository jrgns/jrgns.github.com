---
import Base from "../../layouts/Base.astro";
---

<Base title="Hire Me">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-3xl font-bold mb-6 text-gray-900 dark:text-gray-100">Hire Me</h1>
    <div class="prose dark:prose-invert max-w-none">
      <p class="text-lg text-gray-700 dark:text-gray-300">
        Become more productive by delegating your problem solving to me. I do consulting
        for clients who need an expert developer, integrator and problem solver.
      </p>
      <p>
        My core skills are <strong>Systems and Web Development</strong> in languages such as PHP and Ruby.
      </p>
      <p>
        Contact me for a quote or if you have a question:<br>
        <a href="mailto:jrgns@jrgns.net" class="text-primary-600 dark:text-primary-400 hover:underline">
          jrgns@jrgns.net
        </a>
      </p>
      <p class="mt-8">
        <a
          href="/JJ%20du%20Toit.CV.pdf"
          class="inline-block bg-primary-600 text-white px-6 py-3 rounded-lg hover:bg-primary-700 transition-colors"
        >
          Download CV (PDF)
        </a>
      </p>
    </div>
  </div>
</Base>
