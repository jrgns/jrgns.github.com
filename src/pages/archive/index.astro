---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Blog Archive">
  <header class="mb-10 animate-rise-in">
    <p class="label label--accent">// the full back-catalogue</p>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink">
      Archive
    </h1>
    <p class="mt-3 text-ink-soft">
      {posts.length} posts on systems, data, and AI — dating all the way back.
    </p>
  </header>

  <div class="rounded-xl border border-line bg-paper-2 p-6 shadow-sm sm:p-8">
    <div class="divide-y divide-line/60">
      {
        posts.map((post, i) => (
          <PostCard
            title={post.data.title}
            date={post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
            slug={post.slug}
            section={post.data.section}
            description={post.data.description}
            index={i}
          />
        ))
      }
    </div>
  </div>
</Base>
