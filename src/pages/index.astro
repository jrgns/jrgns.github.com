---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import TalkCard from "../components/TalkCard.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latestPosts = posts.slice(0, 10);

interface Talk {
  title: string;
  event: string;
  url: string;
}

const talks: Talk[] = [
  {
    title: "U2 should have used Elasticsearch",
    event: "DUG",
    url: "/talks/U2_should_have_used_Elasticsearch.pdf",
  },
  {
    title: "Moar logs! Logging on Linux using the ELK Stack",
    event: "JLUG",
    url: "/talks/Moar_Logs.pdf",
  },
  {
    title: "A gentle introduction into Elasticsearch",
    event: "Elasticsearch SA Meetup",
    url: "/talks/Gentle_intro_to_Elasticsearch.pdf",
  },
  {
    title: "Everything's Connected: Hacking the interwebs with Logstash",
    event: "Jozi.rb Meetup",
    url: "/talks/logstash-jozi-rb",
  },
  {
    title: "Leveraging the ELK stack to ensure API uptime",
    event: "Elasticsearch SA Meetup",
    url: "/talks/tutuka-elk",
  },
  {
    title: "Everything's Connected: Hacking the interwebs with Logstash",
    event: "Rubyfuza 2015 (Lightening Talk)",
    url: "/talks/logstash-hacking-the-interwebs",
  },
  {
    title: "How CoffeeScript Improved My JavaScript Skills",
    event: "JSinSA 2014",
    url: "/talks/learning-from-coffeescript",
  },
  {
    title: "PHP - The slums of the programming world?",
    event: "Tech 4 Africa 2013",
    url: "/talks/phpslums/",
  },
];
---

<Base title="A blog about systems and the interwebs">
  <div class="max-w-3xl mx-auto">
    <p class="mb-8 text-gray-700 dark:text-gray-300">
      Be sure to check out
      <a href="https://blog.eagerelk.com" class="text-primary-600 dark:text-primary-400 hover:underline">EagerELK</a>
      - my efforts to explore the <abbr title="Elasticsearch, Logstash, Kibana">ELK</abbr> stack.
    </p>

    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4 text-gray-900 dark:text-gray-100 flex items-center gap-2">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
        Talks
      </h2>
      <p class="text-gray-600 dark:text-gray-400 mb-4">I spoke at</p>
      <ul class="space-y-2">
        {talks.map((talk) => (
          <TalkCard {...talk} />
        ))}
      </ul>
    </section>

    <section>
      <h2 class="text-2xl font-bold mb-4 text-gray-900 dark:text-gray-100 flex items-center gap-2">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        Latest Blog Posts
      </h2>
      <ul class="space-y-4">
        {latestPosts.map((post) => (
          <PostCard
            title={post.data.title}
            date={post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
            slug={post.slug}
            description={post.data.description}
          />
        ))}
      </ul>
      <p class="mt-6">
        <a href="/archive/" class="text-primary-600 dark:text-primary-400 hover:underline">
          More &rarr;
        </a>
      </p>
    </section>
  </div>
</Base>
