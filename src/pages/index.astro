---
import Base from "../layouts/Base.astro";
import TalkCard from "../components/TalkCard.astro";
import { talks } from "../lib/talks";
---

<Base title="A blog about systems and the interwebs">
  <!-- Hero -->
  <section class="animate-rise-in">
    <p class="label label--accent">// systems · logs · the interwebs</p>
    <h1
      class="mt-3 font-display text-4xl font-semibold leading-[1.05] tracking-tight text-ink sm:text-5xl"
    >
      I build systems<br />and <span class="italic text-accent">solve problems</span
      ><span class="cursor"></span>
    </h1>
    <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">
      I'm Jurgens — a systems developer from South Africa. I write about
      Elasticsearch, the ELK stack, and the messy, fascinating ways software
      fits together. Pull up a chair.
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <a
        href="/archive/"
        class="group inline-flex items-center gap-2 rounded-lg border border-ink bg-ink px-4 py-2.5 text-sm font-semibold text-paper transition-colors hover:border-accent hover:bg-accent"
      >
        Read the archive
        <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
      </a>
      <a
        href="/talks/"
        class="link-grow inline-flex items-center gap-1.5 px-1 py-2.5 font-mono text-sm text-ink-soft"
      >
        Browse the talks
      </a>
    </div>
  </section>

  <!-- Talks -->
  <section class="mt-12 rounded-xl border border-line bg-paper-2 p-6 shadow-sm sm:p-8">
    <div class="mb-5 flex items-baseline justify-between gap-4">
      <h2 class="font-display text-2xl font-semibold text-ink">
        Talks I've given
      </h2>
      <a href="/talks/" class="link-grow font-mono text-xs text-ink-soft">all &rarr;</a>
    </div>
    <ul class="divide-y divide-line/60">
      {talks.map((talk) => <TalkCard {...talk} />)}
    </ul>
  </section>
</Base>
