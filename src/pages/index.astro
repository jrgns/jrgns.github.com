---
import Base from "../layouts/Base.astro";
import TalkCard from "../components/TalkCard.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";
import { talks } from "../lib/talks";

// Newest `section: blog` posts; drafts never make the homepage.
const posts = (
  await getCollection("blog", ({ data }) => data.section === "blog" && !data.draft)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="A systems architect's notes on AI and engineering">
  <!-- Hero -->
  <section class="animate-rise-in">
    <p class="label label--accent">// systems · architecture · AI</p>
    <h1
      class="mt-3 font-display text-4xl font-semibold leading-[1.05] tracking-tight text-ink sm:text-5xl"
    >
      AI architecture and<br /><span class="italic text-accent">data at production scale</span
      >
      <svg
        class="ml-1 hidden h-[0.8em] w-[0.8em] align-middle text-accent sm:inline-block"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M2.5 20.5 20.5 12 2.5 3.5 2.5 9.5 12.5 12 2.5 14.5Z" />
      </svg>
    </h1>
    <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">
      I'm jrgns, a systems architect and technologist from sunny South Africa.
      I write and speak about all kinds of technologies, mostly centered around
      development, data, and lately AI.
    </p>
  </section>

  <!-- Articles -->
  <section class="mt-12 rounded-xl border border-line bg-paper-2 p-6 shadow-sm sm:p-8">
    <div class="mb-5 flex items-baseline justify-between gap-4">
      <h2 class="font-display text-2xl font-semibold text-ink">
        Articles
      </h2>
      <a href="/archive/" class="link-grow font-mono text-xs text-ink-soft">browse the archives &rarr;</a>
    </div>
    <ul class="divide-y divide-line/60">
      {
        posts.slice(0, 5).map((post) => (
          <li>
            <PostCard
              title={post.data.title}
              date={post.data.date.toISOString().slice(0, 10)}
              slug={post.slug}
              description={post.data.description}
              section={post.data.section}
            />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Talks -->
  <section class="mt-12 rounded-xl border border-line bg-paper-2 p-6 shadow-sm sm:p-8">
    <div class="mb-5 flex items-baseline justify-between gap-4">
      <h2 class="font-display text-2xl font-semibold text-ink">
        Some of my talks
      </h2>
      <a href="/talks/" class="link-grow font-mono text-xs text-ink-soft">browse the archives &rarr;</a>
    </div>
    <ul class="divide-y divide-line/60">
      {talks.slice(0, 5).map((talk) => <TalkCard {...talk} />)}
    </ul>
  </section>
</Base>
