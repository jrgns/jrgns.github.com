---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("writing");
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Writing">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-3xl font-bold mb-4 text-gray-900 dark:text-gray-100">Writing</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-8">
      Tutorials, case studies, and opinion pieces on AI, systems development, and the interwebs.
    </p>
    {posts.length === 0 ? (
      <p class="text-gray-500 dark:text-gray-400 italic">
        This section is coming soon. Check the <a href="/archive/" class="text-primary-600 dark:text-primary-400 hover:underline">archive</a> for older posts.
      </p>
    ) : (
      <ul class="space-y-6">
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            date={post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
            slug={post.slug}
            description={post.data.description}
          />
        ))}
      </ul>
    )}
  </div>
</Base>
