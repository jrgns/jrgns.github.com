---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("writing");
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Writing">
  <header class="mb-10 animate-rise-in">
    <p class="label label--accent">// fresh ink</p>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink">
      Writing
    </h1>
    <p class="mt-3 max-w-xl text-ink-soft">
      Tutorials, case studies, and opinion pieces on AI, systems development,
      and the interwebs.
    </p>
  </header>

  {
    posts.length === 0 ? (
      <div class="note-card rounded-xl p-8">
        <p class="font-mono text-sm text-ink-soft">
          <span class="text-accent">$</span> ls ./writing
        </p>
        <p class="mt-3 text-ink-soft">
          This section is brewing. In the meantime, dig into the{" "}
          <a href="/archive/" class="link-grow">archive</a> for older posts.
        </p>
      </div>
    ) : (
      <div class="divide-y divide-line/60">
        {posts.map((post, i) => (
          <PostCard
            title={post.data.title}
            date={post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
            slug={post.slug}
            description={post.data.description}
            index={i}
          />
        ))}
      </div>
    )
  }
</Base>
