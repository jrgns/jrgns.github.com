---
import { SITE } from "../lib/site";

const links = [
  { label: "GitHub", href: SITE.github },
  { label: "LinkedIn", href: SITE.linkedin },
  { label: "Twitter", href: SITE.twitter },
  { label: "Hacker News", href: SITE.hackernews },
  { label: "RSS", href: SITE.rss },
];

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-sm">
        <p class="font-display text-xl font-semibold text-ink">
          jrgns<span class="text-accent">.net</span>
        </p>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">
          The postings on this site are my own and don't necessarily represent
          my employer's positions, strategies or opinions.
        </p>
      </div>

      <nav aria-label="Social links">
        <p class="label label--accent mb-3">// elsewhere</p>
        <ul class="grid grid-cols-2 gap-x-8 gap-y-2">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target={l.href.startsWith("http") ? "_blank" : undefined}
                  rel={l.href.startsWith("http") ? "noopener noreferrer" : undefined}
                  class="link-grow font-mono text-sm text-ink-soft"
                >
                  {l.label} <span aria-hidden="true">&#8599;</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="perforate mt-8"></div>

    <div
      class="mt-4 flex flex-col gap-1 font-mono text-xs text-ink-faint sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} Jurgens du Toit — built with Astro &amp; stubbornness.</p>
      <p>Made in South Africa <span class="text-accent">●</span></p>
    </div>
  </div>
</footer>
