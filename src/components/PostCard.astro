---
import { postHref } from "../lib/posts";

interface Props {
  title: string;
  date: string;
  slug: string;
  description?: string;
  index?: number;
  /** Where the post lives; "blog" links to /blog/, anything else to /archive/. */
  section?: "blog" | "archive";
}

const { title, date, slug, description, index, section } = Astro.props;
const num = index !== undefined ? String(index + 1).padStart(2, "0") : null;

// Descriptions are auto-truncated from post bodies, so they can contain raw
// (and sometimes cut-off) Markdown links. Render them as plain text: keep the
// link label, drop the URL and brackets.
function stripMarkdownLinks(text?: string): string | undefined {
  if (!text) return text;
  return text
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1") // complete [label](url)
    .replace(/\[([^\]]+)\]\([^)]*$/g, "$1") // truncated [label](url…
    .replace(/\[([^\]]*)\]?$/g, "$1") // dangling [label or [label]
    .trim();
}

const preview = stripMarkdownLinks(description);
---

<article class="group relative">
  <a href={postHref(section, slug)} class="block py-3">
    <div class="flex items-baseline gap-3">
      {num && <span class="label hidden text-ink-faint sm:inline">{num}</span>}
      <time class="font-mono text-xs text-ink-faint">{date}</time>
      <span class="h-px flex-1 translate-y-[-2px] bg-line"></span>
    </div>
    <h3
      class="mt-1.5 font-display text-xl font-semibold leading-snug text-ink transition-colors group-hover:text-accent"
    >
      <span class="link-marker">{title}</span>
      <span
        class="ml-1 inline-block translate-x-0 text-accent opacity-0 transition-all duration-200 group-hover:translate-x-1 group-hover:opacity-100"
        aria-hidden="true">&rarr;</span
      >
    </h3>
    {
      preview && (
        <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-ink-soft">
          {preview}
        </p>
      )
    }
  </a>
</article>
