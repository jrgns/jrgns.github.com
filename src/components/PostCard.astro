---
interface Props {
  title: string;
  date: string;
  slug: string;
  description?: string;
  index?: number;
}

const { title, date, slug, description, index } = Astro.props;
const num = index !== undefined ? String(index + 1).padStart(2, "0") : null;
---

<article class="group relative">
  <a href={`/archive/${slug}`} class="block py-3">
    <div class="flex items-baseline gap-3">
      {num && <span class="label hidden text-ink-faint sm:inline">{num}</span>}
      <time class="font-mono text-xs text-ink-faint">{date}</time>
      <span class="h-px flex-1 translate-y-[-2px] bg-line"></span>
    </div>
    <h3
      class="mt-1.5 font-display text-xl font-semibold leading-snug text-ink transition-colors group-hover:text-accent"
    >
      <span class="link-marker">{title}</span>
      <span
        class="ml-1 inline-block translate-x-0 text-accent opacity-0 transition-all duration-200 group-hover:translate-x-1 group-hover:opacity-100"
        aria-hidden="true">&rarr;</span
      >
    </h3>
    {
      description && (
        <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-ink-soft">
          {description}
        </p>
      )
    }
  </a>
</article>
