---
interface Props {
  title: string;
  event: string;
  url: string;
}

const { title, event, url } = Astro.props;
const isExternal = url.startsWith("http");
const isPdf = url.toLowerCase().endsWith(".pdf");
const kind = isPdf ? "PDF" : "DECK";
---

<li class="group flex items-baseline gap-3 py-2.5">
  <span
    class="mt-0.5 shrink-0 rounded border border-line px-1.5 py-0.5 font-mono text-[0.6rem] font-semibold tracking-wider text-ink-faint transition-colors group-hover:border-accent group-hover:text-accent"
    >{kind}</span
  >
  <div class="min-w-0">
    <a
      href={url}
      target={isExternal ? "_blank" : undefined}
      rel={isExternal ? "noopener noreferrer" : undefined}
      class="font-medium leading-snug text-ink transition-colors group-hover:text-accent"
    >
      <span class="link-marker">{title}</span>
    </a>
    <p class="font-mono text-xs text-ink-faint">@ {event}</p>
  </div>
</li>
