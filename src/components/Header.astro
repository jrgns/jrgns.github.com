---
const nav = [
  { label: "Home", href: "/" },
  { label: "Writing", href: "/writing/" },
  { label: "Archive", href: "/archive/" },
  { label: "Talks", href: "/talks/" },
];

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? current === "/" : current.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-line bg-paper/85 backdrop-blur-md"
>
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3.5 sm:px-8">
    <a href="/" class="group flex items-baseline gap-0.5 font-mono text-lg font-semibold text-ink">
      <span class="text-accent">~</span><span>/jrgns</span><span class="text-ink-faint">.net</span><span
        class="ml-0.5 inline-block h-4 w-2 translate-y-0.5 bg-accent opacity-0 transition-opacity group-hover:opacity-100"
        aria-hidden="true"></span>
    </a>

    <div class="flex items-center gap-2 sm:gap-3 md:gap-6">
      <!-- Desktop nav -->
      <ul class="hidden items-center gap-7 md:flex">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  "link-marker text-sm font-medium transition-colors",
                  isActive(item.href) ? "text-accent" : "text-ink-soft hover:text-ink",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        class="theme-toggle flex h-9 w-9 items-center justify-center rounded-md border border-line text-ink-soft transition-colors hover:border-accent hover:text-accent"
        aria-label="Toggle light or dark theme"
        title="Toggle light / dark"
      >
        <svg
          class="icon-moon h-[18px] w-[18px]"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <svg
          class="icon-sun h-[18px] w-[18px]"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
          />
        </svg>
      </button>

      <!-- Mobile menu toggle -->
      <button
        id="nav-toggle"
        class="flex h-9 w-9 items-center justify-center rounded-md border border-line text-ink md:hidden"
        aria-label="Toggle navigation"
        aria-expanded="false"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <ul id="nav-menu" class="hidden border-t border-line px-5 py-3 md:hidden">
    {
      nav.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "block py-2 font-mono text-sm",
              isActive(item.href) ? "text-accent" : "text-ink-soft",
            ]}
          >
            <span class="text-ink-faint">&gt;</span> {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</header>

<script is:inline>
  (() => {
    // Mobile nav
    const navToggle = document.getElementById("nav-toggle");
    const menu = document.getElementById("nav-menu");
    if (navToggle && menu) {
      navToggle.addEventListener("click", () => {
        menu.classList.toggle("hidden");
        navToggle.setAttribute(
          "aria-expanded",
          menu.classList.contains("hidden") ? "false" : "true"
        );
      });
    }

    // Light / dark theme toggle
    const themeToggle = document.getElementById("theme-toggle");
    const root = document.documentElement;
    const systemDark = window.matchMedia("(prefers-color-scheme: dark)");
    const effective = () =>
      root.getAttribute("data-theme") || (systemDark.matches ? "dark" : "light");
    if (themeToggle) {
      themeToggle.addEventListener("click", () => {
        const next = effective() === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        try {
          localStorage.setItem("theme", next);
        } catch (e) {}
      });
    }
  })();
</script>
